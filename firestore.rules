rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // GELİŞTİRME İÇİN AÇIK BIRAKILMIŞTIR. CANLI KULLANIMDA BUNU KESİNLİKLE
    // Firebase Authentication + role-based rules ile değiştirin.
    match /teachers/{teacherId} { allow read, create, update, delete: if true; }
    match /students/{studentId} { allow read, create, update, delete: if true; }
    match /attendance/{attendanceId} { allow read, create, update, delete: if true; }
  }
}